<script>
  // 1. TAB NAVIGATION
  function showTab(tabId, el) {
    document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    el.classList.add('active');
  }

  // 2. LANGUAGE MODE TOGGLE
  function toggleLang() {
    const b = document.body;
    const btn = document.getElementById('langBtn');
    if (b.classList.contains('mode-hi')) {
      b.classList.replace('mode-hi', 'mode-en');
      btn.innerText = '🌐 Mode: Exam English (Formal)';
      btn.classList.add('english');
    } else {
      b.classList.replace('mode-en', 'mode-hi');
      btn.innerText = '🌐 Mode: Hinglish (Easy)';
      btn.classList.remove('english');
    }
  }

  // 3. POMODORO TIMER
  let timeLeft = 25 * 60;
  let timerId = null;
  function updateTimerUI() {
    const m = String(Math.floor(timeLeft / 60)).padStart(2, '0');
    const s = String(timeLeft % 60).padStart(2, '0');
    document.getElementById('timerDisplay').innerText = `${m}:${s}`;
  }
  function startTimer() {
    if (timerId) return;
    timerId = setInterval(() => {
      if (timeLeft > 0) { timeLeft--; updateTimerUI(); }
      else { clearInterval(timerId); timerId = null; alert('Pomodoro Sprint Complete! Take a 5 min break.'); }
    }, 1000);
  }
  function pauseTimer() { clearInterval(timerId); timerId = null; }
  function resetTimer() { pauseTimer(); timeLeft = 25 * 60; updateTimerUI(); }

  // 4. APRIORI SOLVER
  function solveApriori() {
    const sPct = parseFloat(document.getElementById('apSup').value) || 0;
    const cPct = parseFloat(document.getElementById('apConf').value) || 0;
    const minCnt = Math.ceil((sPct / 100) * 6 - 0.01);

    const rules = [
      { lhs: 'Hot Dogs ^ Coke', rhs: 'Chips', num: 2, den: 2 },
      { lhs: 'Hot Dogs ^ Chips', rhs: 'Coke', num: 2, den: 2 },
      { lhs: 'Coke ^ Chips', rhs: 'Hot Dogs', num: 2, den: 3 },
      { lhs: 'Coke', rhs: 'Hot Dogs ^ Chips', num: 2, den: 3 },
      { lhs: 'Hot Dogs', rhs: 'Coke ^ Chips', num: 2, den: 4 },
      { lhs: 'Chips', rhs: 'Hot Dogs ^ Coke', num: 2, den: 4 }
    ];

    let html = `<div><strong>Step 1: Min Support Count</strong> = (${sPct}/100) &times; 6 = <strong>${minCnt}</strong></div>`;
    html += `<div style="margin-top:6px;"><strong>Step 2: Frequent 3-Itemset:</strong> {Hot Dogs, Coke, Chips} (Support Count = 2)</div>`;
    html += `<div style="margin-top:8px;"><strong>Step 3: Association Rules (Min Conf = ${cPct}%):</strong><ul style="margin-top:4px;">`;
    rules.forEach(r => {
      const conf = ((r.num / r.den) * 100).toFixed(2);
      const pass = conf >= cPct;
      html += `<li><code>[${r.lhs}] &rArr; [${r.rhs}]</code>: ${r.num}/${r.den} = <strong>${conf}%</strong> — <span style="color:${pass ? '#10b981' : '#ef4444'}">${pass ? 'SELECTED' : 'REJECTED'}</span></li>`;
    });
    html += `</ul></div>`;
    document.getElementById('aprioriOut').innerHTML = html;
  }

  // 5. ENTROPY SOLVER
  function solveEntropy() {
    const p = parseFloat(document.getElementById('entPos').value) || 0;
    const n = parseFloat(document.getElementById('entNeg').value) || 0;
    const tot = p + n;
    if (tot === 0) { document.getElementById('entropyOut').innerHTML = 'Enter non-zero counts.'; return; }
    const pp = p / tot, pn = n / tot;
    const e10 = (pp > 0 ? -pp * Math.log10(pp) : 0) + (pn > 0 ? -pn * Math.log10(pn) : 0);
    const e2  = (pp > 0 ? -pp * Math.log2(pp) : 0)  + (pn > 0 ? -pn * Math.log2(pn) : 0);

    document.getElementById('entropyOut').innerHTML = `
      <div><strong>Total Samples:</strong> ${tot} (P(+) = ${p}/${tot}, P(-) = ${n}/${tot})</div>
      <div style="margin-top:8px;"><strong>Textbook Formula (log10):</strong><br><code>Entropy = ${e10.toFixed(4)}</code></div>
      <div style="margin-top:8px;"><strong>Standard Formula (log2):</strong><br><code>Entropy = ${e2.toFixed(4)} bits</code></div>
      <div style="margin-top:8px; color:var(--warn);">${(p===0 || n===0) ? '✨ PURE NODE (Entropy = 0)' : (p===n ? '⚠️ MAX IMPURITY (50/50 Split)' : 'Mixed Node')}</div>
    `;
  }

  // 6. Q-LEARNING SOLVER
  function solveQL() {
    const q = parseFloat(document.getElementById('qOld').value) || 0;
    const a = parseFloat(document.getElementById('qAlpha').value) || 0;
    const r = parseFloat(document.getElementById('qRew').value) || 0;
    const g = parseFloat(document.getElementById('qGamma').value) || 0;
    const m = parseFloat(document.getElementById('qMaxNext').value) || 0;

    const tdTarget = r + g * m;
    const tdError = tdTarget - q;
    const qNew = q + a * tdError;

    document.getElementById('qlOut').innerHTML = `
      <div><strong>Formula:</strong><br><code>Q(s,a) &larr; Q(s,a) + &alpha;[r + &gamma; max Q(s',a') - Q(s,a)]</code></div>
      <div style="margin-top:8px;"><strong>Step 1 (TD Target):</strong> ${r} + (${g} &times; ${m}) = <strong>${tdTarget.toFixed(2)}</strong></div>
      <div style="margin-top:4px;"><strong>Step 2 (TD Error):</strong> ${tdTarget.toFixed(2)} - ${q} = <strong>${tdError.toFixed(2)}</strong></div>
      <div style="margin-top:8px; font-size:1.05rem; color:var(--success);"><strong>Updated Q(s,a) = ${qNew.toFixed(3)}</strong></div>
    `;
  }

  // 7. ACTIVE RECALL Q&A BANK
  const questions = [
    { q: "Q1. What is a Knowledge-Based Agent and how do TELL and ASK work?", kw: ["knowledge base", "inference engine", "tell", "ask", "partially observable"], a: "A Knowledge-Based Agent uses a Knowledge Base (domain-specific facts) and an Inference Engine (domain-independent algorithms) to act in partially observable environments. TELL adds new percept sentences to the KB, while ASK queries the KB to infer the best action." },
    { q: "Q2. Differentiate between Forward Chaining and Backward Chaining.", kw: ["data-driven", "goal-driven", "bottom-up", "top-down", "bfs", "dfs"], a: "Forward Chaining is data-driven, bottom-up reasoning starting from known facts to conclusions using BFS. Backward Chaining is goal-driven, top-down reasoning starting from the goal to supporting facts using DFS (used in diagnostic systems)." },
    { q: "Q3. What is the difference between STRIPS and ADL planning languages?", kw: ["positive", "negative", "closed-world", "open-world", "quantified"], a: "STRIPS allows only positive literals, ground conjunction goals, and uses the Closed-World Assumption (unmentioned literals are False). ADL allows positive and negative literals, quantified variables, disjunctions, and uses the Open-World Assumption." },
    { q: "Q4. Explain the 4 theoretical components of a General Learning Agent.", kw: ["performance element", "critic", "learning element", "problem generator"], a: "1. Performance Element (selects actions via sensors/effectors), 2. Critic (evaluates actions against a performance standard and gives feedback), 3. Learning Element (updates the performance element), 4. Problem Generator (suggests exploratory actions/experiments)." },
    { q: "Q5. Explain Bias-Variance Tradeoff, Overfitting, and Underfitting.", kw: ["bias", "variance", "underfitting", "overfitting", "regularization"], a: "Bias is error from overly simple assumptions (High Bias causes Underfitting: high train & test error). Variance is sensitivity to training noise (High Variance causes Overfitting: low train error, high test error, prevented via Regularization, Dropout, and Pruning). Total Error = Bias² + Variance + Irreducible Noise." },
    { q: "Q6. What is the Expectation-Maximization (EM) Algorithm and its two steps?", kw: ["hidden", "latent", "e-step", "m-step", "log-likelihood"], a: "EM learns probability model parameters when data has hidden (latent) variables. 1. E-Step (Expectation): Infers expected cluster probabilities P(C=i|x) given current parameters. 2. M-Step (Maximization): Updates parameters (mean, covariance, weights) to maximize expected log-likelihood." },
    { q: "Q7. Define a Hidden Markov Model (HMM) and state its training and decoding algorithms.", kw: ["hidden states", "observations", "transition", "emission", "baum-welch", "viterbi"], a: "An HMM models sequential data using hidden states (Transition matrix) and visible observations (Emission matrix). It is trained using the Baum-Welch (Forward-Backward) algorithm, and the most likely sequence of hidden states is decoded using the Viterbi algorithm." },
    { q: "Q8. Define Markov Decision Process (MDP) and compare ADP, TD, and Q-Learning.", kw: ["states", "actions", "transition", "reward", "discount", "markov property", "bellman", "model-free"], a: "An MDP has 5 components: States (S), Actions (A), Transition Probability P(s'|s,a), Reward R(s), and Discount Factor (gamma), governed by the Markov Property. ADP is model-based passive RL; TD is model-free passive RL; Q-Learning is model-free, off-policy active RL that learns action-utility Q(s,a)." },
    { q: "Q9. What is Responsible AI? Differentiate between Transparency and Explainability.", kw: ["fairness", "transparency", "explainability", "accountability", "human oversight", "black box"], a: "Responsible AI ensures ethical, fair, safe, and accountable AI. Transparency refers to open documentation of data, design, and algorithms, while Explainability is the ability to provide clear reasons why a black-box model generated a specific prediction." },
    { q: "Q10. What are the major risks in Generative AI (Hallucinations, Deepfakes, Bias)?", kw: ["hallucination", "deepfake", "bias", "privacy", "copyright"], a: "Key Generative AI risks include: 1. Hallucinations (fabricated false facts/references), 2. Deepfakes & Misinformation, 3. Bias & Unfairness, 4. Privacy & Data Leakage, 5. Copyright/IP infringement, 6. Phishing/Security threats, and 7. Overdependence." }
  ];

  function renderQA() {
    const container = document.getElementById('qaList');
    container.innerHTML = questions.map((item, idx) => `
      <div class="qa-item searchable">
        <div class="qa-q"><span>${item.q}</span></div>
        <textarea class="qa-textarea" id="ansInput-${idx}" placeholder="Type key points or keywords here to test your memory..." oninput="checkKeywords(${idx})"></textarea>
        <div id="kwBox-${idx}" style="margin-bottom:8px;">
          <span style="font-size:0.75rem; color:var(--muted);">Target Keywords: </span>
          ${item.kw.map(k => `<span class="kw-badge" data-kw="${k}">${k}</span>`).join('')}
        </div>
        <button class="btn-sm" onclick="document.getElementById('ansBox-${idx}').style.display='block'">👁️ Show Model Exam Answer</button>
        <div class="qa-ans" id="ansBox-${idx}"><strong>Model Answer:</strong> ${item.a}</div>
      </div>
    `).join('');
  }

  function checkKeywords(idx) {
    const val = document.getElementById(`ansInput-${idx}`).value.toLowerCase();
    const badges = document.querySelectorAll(`#kwBox-${idx} .kw-badge`);
    badges.forEach(b => {
      const kw = b.getAttribute('data-kw');
      if (val.includes(kw)) b.classList.add('hit');
      else b.classList.remove('hit');
    });
  }

  // 8. GLOBAL SEARCH
  function runSearch() {
    const q = document.getElementById('globalSearch').value.toLowerCase();
    document.querySelectorAll('.searchable').forEach(el => {
      el.style.display = el.innerText.toLowerCase().includes(q) ? 'block' : 'none';
    });
  }

  // 9. SAVE & LOAD PROGRESS
  function saveProgress() {
    const checks = document.querySelectorAll('.master-check');
    let done = 0;
    const states = [];
    checks.forEach((c, i) => {
      states.push(c.checked);
      if (c.checked) { done++; c.closest('.card').classList.add('mastered'); }
      else { c.closest('.card').classList.remove('mastered'); }
    });
    localStorage.setItem('ai_pro_progress', JSON.stringify(states));
    const pct = Math.round((done / checks.length) * 100);
    document.getElementById('progPct').innerText = pct + '%';
    document.getElementById('progFill').style.width = pct + '%';
  }

  function loadProgress() {
    const saved = JSON.parse(localStorage.getItem('ai_pro_progress') || '[]');
    const checks = document.querySelectorAll('.master-check');
    checks.forEach((c, i) => { if (saved[i]) c.checked = true; });
    saveProgress();
  }

  // INIT
  solveApriori();
  solveEntropy();
  solveQL();
  renderQA();
  loadProgress();
</script>

