<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Exam Command Center Pro</title>
  <style>
    :root {
      --bg: #090d16;
      --panel: #111827;
      --card: #1f2937;
      --border: #374151;
      --text: #f9fafb;
      --muted: #9ca3af;
      --accent: #38bdf8;
      --accent2: #818cf8;
      --success: #10b981;
      --warn: #f59e0b;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); display: flex; min-height: 100vh; overflow-x: hidden; }

    /* Sidebar */
    aside {
      width: 270px; background: var(--panel); border-right: 1px solid var(--border);
      display: flex; flex-direction: column; position: fixed; height: 100vh; z-index: 50;
    }
    .brand { padding: 18px 20px; border-bottom: 1px solid var(--border); }
    .brand h1 { font-size: 1.15rem; color: var(--accent); font-weight: 800; letter-spacing: 0.5px; }
    .brand p { font-size: 0.78rem; color: var(--muted); margin-top: 4px; }

    .timer-box {
      margin: 14px; padding: 12px; background: var(--card); border: 1px solid var(--border);
      border-radius: 10px; text-align: center;
    }
    .timer-display { font-size: 1.6rem; font-weight: 800; font-family: monospace; color: var(--warn); }
    .timer-btns { display: flex; gap: 6px; justify-content: center; margin-top: 8px; }
    .btn-sm {
      background: var(--border); color: var(--text); border: none; padding: 5px 10px;
      border-radius: 6px; cursor: pointer; font-size: 0.75rem; font-weight: 600;
    }
    .btn-sm:hover { background: var(--accent); color: #000; }

    .nav-list { list-style: none; padding: 10px; flex: 1; overflow-y: auto; }
    .nav-item {
      padding: 11px 14px; border-radius: 8px; cursor: pointer; color: var(--muted);
      font-weight: 600; font-size: 0.9rem; margin-bottom: 4px; display: flex; align-items: center; gap: 10px;
    }
    .nav-item:hover { background: rgba(56, 189, 248, 0.1); color: var(--text); }
    .nav-item.active { background: var(--accent); color: #090d16; font-weight: 700; }

    .sidebar-footer { padding: 14px; border-top: 1px solid var(--border); }
    .prog-bar-bg { background: var(--card); height: 8px; border-radius: 4px; overflow: hidden; margin-top: 6px; }
    .prog-bar-fill { background: var(--success); height: 100%; width: 0%; transition: width 0.3s; }

    /* Main Content Area */
    .main-wrap { margin-left: 270px; flex: 1; display: flex; flex-direction: column; width: calc(100% - 270px); }
    .topbar {
      position: sticky; top: 0; z-index: 40; background: rgba(17, 24, 39, 0.95);
      backdrop-filter: blur(8px); border-bottom: 1px solid var(--border);
      padding: 12px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;
    }
    .search-box {
      background: var(--card); border: 1px solid var(--border); color: var(--text);
      padding: 9px 14px; border-radius: 8px; width: 300px; outline: none; font-size: 0.9rem;
    }
    .search-box:focus { border-color: var(--accent); }
    .top-actions { display: flex; gap: 10px; align-items: center; }
    .lang-toggle {
      background: var(--card); border: 1px solid var(--accent); color: var(--accent);
      padding: 8px 14px; border-radius: 8px; cursor: pointer; font-weight: 700; font-size: 0.85rem;
    }
    .lang-toggle.english { background: var(--accent2); color: #fff; border-color: var(--accent2); }
    .print-btn {
      background: var(--success); color: #052e16; border: none; padding: 8px 14px;
      border-radius: 8px; cursor: pointer; font-weight: 700; font-size: 0.85rem;
    }

    .content-section { padding: 24px; max-width: 1100px; margin: 0 auto; width: 100%; display: none; }
    .content-section.active { display: block; }

    /* Cards & Tables */
    .card {
      background: var(--card); border: 1px solid var(--border); border-radius: 12px;
      padding: 20px; margin-bottom: 20px;
    }
    .card.mastered { border-color: var(--success); }
    .card-head { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 10px; margin-bottom: 14px; }
    .card-title { font-size: 1.15rem; font-weight: 700; color: var(--accent); }
    .tag { font-size: 0.72rem; background: var(--panel); color: var(--warn); padding: 3px 8px; border-radius: 4px; border: 1px solid var(--warn); margin-left: 8px; }
    
    table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 0.9rem; }
    th, td { border: 1px solid var(--border); padding: 10px; text-align: left; vertical-align: top; }
    th { background: var(--panel); color: var(--accent); font-weight: 700; }
    tr:nth-child(even) { background: rgba(255,255,255,0.02); }

    ul, ol { padding-left: 20px; margin: 8px 0; }
    li { margin-bottom: 6px; line-height: 1.5; }
    .hl { color: #fde047; font-weight: 600; }
    .code-box {
      background: var(--panel); border-left: 4px solid var(--accent); padding: 12px;
      font-family: monospace; font-size: 0.9rem; color: #7dd3fc; margin: 10px 0; overflow-x: auto;
    }

    /* Diagram Flow Boxes */
    .diagram-box {
      background: var(--panel); border: 1px dashed var(--accent); border-radius: 8px;
      padding: 16px; margin: 12px 0; font-family: monospace; white-space: pre; overflow-x: auto;
      line-height: 1.35; color: #a5f3fc; font-size: 0.85rem;
    }

    /* Interactive Solvers */
    .solver-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .input-group { margin-bottom: 10px; }
    .input-group label { display: block; font-size: 0.82rem; color: var(--muted); margin-bottom: 4px; }
    .input-group input {
      width: 100%; padding: 8px 10px; background: var(--panel); border: 1px solid var(--border);
      color: var(--text); border-radius: 6px;
    }
    .result-box { background: var(--panel); padding: 14px; border-radius: 8px; border: 1px solid var(--border); font-size: 0.9rem; }

    /* Exam Tester */
    .qa-item { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin-bottom: 14px; }
    .qa-q { font-weight: 700; color: var(--accent); margin-bottom: 8px; display: flex; justify-content: space-between; }
    .qa-textarea {
      width: 100%; height: 65px; background: var(--panel); border: 1px solid var(--border);
      color: var(--text); border-radius: 6px; padding: 8px; font-size: 0.88rem; margin-bottom: 8px; resize: vertical;
    }
    .qa-ans { display: none; margin-top: 10px; padding: 12px; background: var(--panel); border-left: 3px solid var(--success); border-radius: 4px; font-size: 0.9rem; }
    .kw-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; margin: 2px; background: #374151; }
    .kw-badge.hit { background: #065f46; color: #a7f3d0; border: 1px solid #10b981; }

    /* Language visibility */
    body.mode-en .lang-hi { display: none !important; }
    body.mode-hi .lang-en { display: none !important; }

    @media (max-width: 850px) {
      aside { width: 100%; height: auto; position: relative; border-right: none; border-bottom: 1px solid var(--border); }
      body { flex-direction: column; }
      .main-wrap { margin-left: 0; width: 100%; }
      .solver-grid { grid-template-columns: 1fr; }
    }
    @media print {
      aside, .topbar, .btn-sm, .qa-textarea { display: none !important; }
      .main-wrap { margin: 0; width: 100%; }
      .content-section { display: block !important; padding: 10px; }
      body { background: #fff; color: #000; }
      .card, .qa-item { background: #fff; border: 1px solid #ccc; color: #000; page-break-inside: avoid; }
      .card-title, th, .qa-q { color: #000 !important; }
      .qa-ans { display: block !important; background: #f8fafc; color: #000; }
      .diagram-box, .code-box { background: #f1f5f9; color: #000; border-color: #000; }
    }
  </style>
</head>
